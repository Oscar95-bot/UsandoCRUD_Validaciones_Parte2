@model UsandoCRUD_Validaciones.Models.Categoria

@{
    ViewData["Title"] = "Crear Categoría";
}

<form method="post" asp-action="Crear">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Crear Nueva Categoría</h2>
            <hr />
        </div>

        <div class="mb-3">
            <label class="form-label">Nombre de la Categoría</label>
            <input asp-for="NombreCategoria" class="form-control" />
            <span asp-validation-for="NombreCategoria" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Orden de Visualización</label>
            <input asp-for="Orden" class="form-control" />
            <span asp-validation-for="Orden" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width:150px">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary" style="width:150px">Volver</a>
    </div>
</form>

@section Scripts {
    @{ <partial name="_ValidationScriptsPartial" /> }
}
